{
  "name": "@nutreitor/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./tenant": {
      "types": "./dist/tenant/with-tenant.d.ts",
      "default": "./dist/tenant/with-tenant.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./catalog": {
      "types": "./dist/catalog/build-food-catalog.d.ts",
      "default": "./dist/catalog/build-food-catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "catalog:build": "tsx scripts/build-food-catalog.ts",
    "db:reset-dev": "tsx scripts/reset-dev.ts",
    "recipes:build": "tsx scripts/build-recipe-library.ts"
  },
  "dependencies": {
    "@nutreitor/config": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
