---
/**
 * Vista ilustrativa del producto (no es un dato real): un plan de día de partido
 * con el registro del deportista. Marcado como figura para lectores de pantalla.
 */
---
<figure class="mock" aria-label="Ejemplo: plan de día de partido de un mediocampista, con lo que ya registró">
  <div class="card plan">
    <div class="head">
      <span class="who">Tomás · mediocampista</span>
      <span class="chips" aria-hidden="true">
        <span class="chip on">Día de partido</span>
        <span class="chip">Descanso</span>
      </span>
    </div>
    <ul class="meals">
      <li><span>Precompetencia · arroz, pollo y banana</span><b class="ok">Cumplí</b></li>
      <li><span>Entretiempo · gel y bebida isotónica</span><b class="part">En parte</b></li>
      <li class="todo"><span>Recuperación · licuado con proteína</span><b>Pendiente</b></li>
    </ul>
    <p class="macros">3.100 kcal · Carbohidratos 7 g/kg · Proteína 1,8 g/kg</p>
  </div>
  <div class="mini">
    <div class="card small">
      <p class="label">Composición corporal</p>
      <p class="value">Peso · % graso · masa muscular</p>
    </div>
    <div class="card small">
      <p class="label">Consulta nueva</p>
      <p class="quote">“Corro mi primera maratón en marzo”</p>
    </div>
  </div>
  <figcaption class="sr-only">Ilustración del producto con datos de ejemplo.</figcaption>
</figure>

<style>
  .mock {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .plan {
    padding: 22px;
    box-shadow: 0 24px 48px -28px rgb(14 31 36 / 0.25);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    align-items: center;
  }
  .who {
    font-weight: 700;
    font-size: 15px;
  }
  .chips {
    display: flex;
    gap: 6px;
    font-size: 13px;
  }
  .chip {
    border: 1px solid #c9d8d8;
    color: var(--ink-2);
    padding: 5px 10px;
    border-radius: 999px;
  }
  .chip.on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .meals {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .meals li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    background: var(--soft);
    border-radius: 12px;
    font-size: 14px;
  }
  .meals li.todo {
    background: transparent;
    border: 1px dashed #c9d8d8;
    color: var(--ink-3);
  }
  .meals b {
    white-space: nowrap;
  }
  .ok {
    color: var(--accent);
  }
  .part {
    color: var(--warn);
  }
  .macros {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }
  .mini {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .small {
    padding: 18px;
  }
  .label {
    margin: 0;
    font-size: 13px;
    color: var(--ink-3);
  }
  .value {
    margin: 6px 0 0;
    font-size: 16px;
    font-weight: 700;
  }
  .quote {
    margin: 6px 0 0;
    font-size: 15px;
    font-weight: 600;
  }
  @media (max-width: 420px) {
    .mini {
      grid-template-columns: 1fr;
    }
    .meals li {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
