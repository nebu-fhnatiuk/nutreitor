---
/** Marca: cuadrado de acento + nombre en minúsculas. */
---
<a href="/" class="logo" aria-label="Nutreitor, inicio">
  <span class="mark" aria-hidden="true"></span>
  <span class="name">nutreitor</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }
  .mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
  }
  .name {
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
</style>
