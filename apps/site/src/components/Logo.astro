---
/** Marca: círculo con los dos colores (el del club de ejemplo) + nombre condensado. */
---
<a href="/" class="logo" aria-label="Nutreitor, inicio">
  <span class="mark" aria-hidden="true"></span>
  <span class="name">NUTREITOR</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }
  .mark {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--brand);
    box-shadow: 0 0 0 3px var(--accent2);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: 0.08em;
  }
</style>
