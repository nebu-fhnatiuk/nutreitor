---
/** Tarjeta de funcionalidad: etiqueta corta, título y descripción. */
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---
<article class="card feature">
  <p class="eyebrow">{eyebrow}</p>
  <h3>{title}</h3>
  <p class="body"><slot /></p>
</article>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.25;
    font-weight: 700;
  }
  .body {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
</style>
