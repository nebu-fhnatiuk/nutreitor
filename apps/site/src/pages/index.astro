---
import Base from "../layouts/Base.astro";
import PhoneMock from "../components/PhoneMock.astro";
import ClubSwitch from "../components/ClubSwitch.astro";
import PitchBand from "../components/PitchBand.astro";
import Moments from "../components/Moments.astro";
import Trust from "../components/Trust.astro";
import Steps from "../components/Steps.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { links, site } from "../config";
import { faqLd } from "../faq";

const faq = [
  {
    q: "¿Sirve si trabajo solo/a?",
    a: "Sí. Elegís cuenta de profesional independiente y entrás directo a tu día: deportistas, agenda, planes y mensajes. Si después sumás colegas, la pasás a equipo sin perder nada.",
  },
  {
    q: "¿Mis deportistas tienen que instalar una app?",
    a: "No hace falta. Entran a su portal desde el link que les mandás y lo pueden agregar a la pantalla de inicio del celular como una app.",
  },
  {
    q: "¿Puedo armar un plan distinto para los días de entrenamiento y los de descanso?",
    a: "Sí. Los planes pueden ser de un día tipo o semanales, con un plan distinto para cada día, y los macros se calculan solos desde la base de alimentos.",
  },
  {
    q: "¿Por qué revisan el alta y la matrícula?",
    a: "Porque tu vidriera recibe datos de salud de personas reales. Mientras revisamos, configurás todo; tu perfil se publica cuando la matrícula queda revisada.",
  },
  {
    q: "¿Quién puede ver lo que me cuenta un deportista?",
    a: "Sólo vos. En un club, la coordinación ve los números del equipo, pero no las conversaciones entre cada deportista y su nutricionista.",
  },
];
---
<Base title={site.name} jsonLd={faqLd(faq)}>
  <section class="wrap hero">
    <div class="copy">
      <p class="eyebrow">Nutrición deportiva</p>
      <h1 class="h1">Cada deportista sabe qué le toca hoy.</h1>
      <p class="lead">
        El plan cambia si hay partido, entreno o descanso. Vos medís y prescribís; el deportista lo ve en su
        celular, con los colores de su club. Para tu consultorio, tu club o tu gimnasio.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={links.signup}>Creá tu espacio</a>
        <a class="btn btn-ghost" href="#como">Ver cómo funciona</a>
      </div>
      <p class="have">¿Ya tenés tu espacio? <a href="/ingresar">Ingresá →</a></p>
      <div class="try"><ClubSwitch /></div>
    </div>
    <div class="visual">
      <PhoneMock />
    </div>
  </section>

  <PitchBand />
  <Moments />

  <section id="para-quien" class="night">
    <div class="wrap section">
      <p class="eyebrow on-night">Para quién</p>
      <h2 class="h2 title">Tu club, tu gimnasio o tu consultorio.</h2>
      <div class="audiences">
        <a class="aud" href="/clubes">
          <h3 class="h3">Clubes</h3>
          <p>Varios nutricionistas, cada deportista con su profesional y la coordinación viendo los números del plantel. Con el escudo y los colores del club.</p>
          <span class="more">Ver clubes →</span>
        </a>
        <a class="aud" href="/gimnasios">
          <h3 class="h3">Gimnasios</h3>
          <p>Tus socios reservan con el nutricionista del gimnasio y siguen su plan desde el celular, con tu marca.</p>
          <span class="more">Ver gimnasios →</span>
        </a>
        <div class="aud">
          <h3 class="h3">Independientes</h3>
          <p>Corredores, ciclistas, crossfiteros, amateurs y alto rendimiento: tu vidriera con tu matrícula, turnos, planes y el portal de cada deportista.</p>
        </div>
      </div>
    </div>
  </section>

  <Trust />
  <Steps />
  <Faq items={faq} />
  <CtaBand title="El partido empieza en la semana." contactHref="/clubes#contacto" />
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
    padding-block: clamp(32px, 5vw, 56px) clamp(48px, 6vw, 64px);
  }
  .copy {
    flex: 1 1 480px;
    min-width: 0;
  }
  .copy .h1 {
    margin-top: 10px;
  }
  .copy .lead {
    margin: 24px 0 0;
    max-width: 34rem;
  }
  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .have {
    margin: 18px 0 0;
    font-size: 16px;
    color: var(--ink-2);
  }
  .have a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--brand-ink);
  }
  .try {
    margin-top: 24px;
  }
  .visual {
    flex: 1 1 360px;
    min-width: 0;
  }
  .night {
    background: var(--night);
    color: #f3f4f6;
  }
  .on-night {
    color: var(--accent2);
  }
  .title {
    margin-top: 8px;
  }
  .audiences {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }
  .aud {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--night-line);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  a.aud:hover {
    border-color: var(--accent2);
    color: inherit;
  }
  .aud p {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--night-ink);
  }
  .more {
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent2);
  }
</style>
