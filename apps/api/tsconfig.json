{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    // Nest borra dist (deleteOutDir) en cada arranque; con incremental, un
    // .tsbuildinfo fuera de dist haría que tsc crea que está al día y no emita.
    "incremental": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false
  },
  // Sólo modo watch (dev): en colima/macOS el watcher nativo no ve los cambios del
  // bind-mount (archivos nuevos), así que se usa polling. No afecta el build.
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
