# ─────────────────────────────────────────────────────────────────────────────
# Entorno de Nutreitor — copiá este archivo a `.env` y ajustá los valores.
# En docker-compose estos valores ya vienen seteados; este archivo documenta
# el contrato de variables y sirve para correr cosas fuera del contenedor.
#
# Config por entorno: el CONTRATO de variables es el mismo en dev/staging/prod;
# cambia el INYECTOR. dev → este `.env` vía compose. staging/prod → NO se usan
# archivos .env: las variables (sobre todo los secretos) se inyectan desde AWS
# Secrets Manager / SSM Parameter Store hacia el task de Fargate (ver README).
# Nunca commitear secrets reales; los de acá son placeholders de dev.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Postgres ────────────────────────────────────────────────────────────────
# El servicio `db` de docker-compose crea la base y ambos roles (ver
# packages/db/migrations/0001_roles_and_rls.sql). Dos conexiones distintas:
#
#  - DATABASE_OWNER_URL: rol dueño del schema. Corre migraciones y seeds.
#    BYPASSEA RLS (es owner de las tablas). NUNCA lo usa el runtime de la API.
#  - DATABASE_URL: rol de runtime de la API. NO es owner, sin BYPASSRLS.
#    Sobre él aplica FORCE ROW LEVEL SECURITY. Es el único pool de la app.
#
# Host `db` dentro de la red de compose; `localhost` si corrés contra el puerto
# publicado 5432 desde la máquina host.
POSTGRES_DB=nutreitor
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_OWNER_URL=postgresql://nutreitor_owner:owner_dev_pwd@db:5432/nutreitor
DATABASE_URL=postgresql://nutreitor_app:app_dev_pwd@db:5432/nutreitor

# ── Auth (self-hosted) ───────────────────────────────────────────────────────
# Access = JWT corto (firma HS256); refresh = token opaco con hash en DB.
# En prod: secretos por Secrets Manager, COOKIE_SECURE=true detrás de TLS.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TTL=900s
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
# Dominio raíz: distingue landing (raíz) de workspace ({slug}.ROOT_DOMAIN).
ROOT_DOMAIN=localhost

# ── Borde edge↔API ────────────────────────────────────────────────────────────
# Secreto compartido entre el proxy de Next (edge) y la API. El edge lo manda en
# `x-internal-secret`; la API rechaza lo que no lo traiga (salvo /health). Defensa
# en profundidad: el borde primario en prod es de red (API en subnet privada).
# Mismo valor en api y web. min 16 chars.
EDGE_SHARED_SECRET=dev-edge-shared-secret-change-me

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# ── Web ──────────────────────────────────────────────────────────────────────
# El browser pega SIEMPRE al proxy de Next; éste reenvía a la API por la red
# interna. Cookies first-party por subdominio del tenant.
API_INTERNAL_URL=http://api:3001

# ── Regiones de residencia de datos (enum) ────────────────────────────────────
# Valores válidos de `region`: us-east-1 | eu-central-1 | sa-east-1
# (definidos en packages/db/src/schema/_region.ts; agregar = ALTER TYPE region ADD VALUE).
