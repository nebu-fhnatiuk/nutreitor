{
  "name": "nutreitor",
  "version": "0.0.1",
  "private": true,
  "description": "Plataforma multi-tenant de captación y seguimiento de pacientes (nutrición)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @nutreitor/db generate",
    "db:migrate": "pnpm --filter @nutreitor/db migrate",
    "db:seed": "pnpm --filter @nutreitor/db seed"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
